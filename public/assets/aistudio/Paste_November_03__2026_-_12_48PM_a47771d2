      EmailAttachmentService.ts
      EmailApprovalService.ts
      EmailAuditService.ts
      EmailHealthService.ts
      EmailRecoveryService.ts
    types/
      EmailProvider.ts
      EmailConnection.ts
      EmailMessage.ts
      EmailThread.ts
      EmailDelivery.ts
```

Adapt these paths to the existing codebase rather than duplicating existing services.

Create a common connector contract supporting the following operations:

```typescript
interface EmailConnector {
  connect(): Promise<ConnectionResult>;

  verifyConnection(): Promise<ConnectionHealth>;

  listFolders(): Promise<EmailFolder[]>;

  listMessages(
    options: MessageQueryOptions
  ): Promise<EmailMessagePage>;

  getMessage(
    providerMessageId: string
  ): Promise<EmailMessage>;

  syncMessages(
    cursor?: string
  ): Promise<SyncResult>;

  sendMessage(
    message: ApprovedOutboundMessage
  ): Promise<SendResult>;

  saveDraft(
    message: EmailDraft
  ): Promise<DraftResult>;

  markRead(
    messageId: string,
    read: boolean
  ): Promise<void>;

  moveMessage(
    messageId: string,
    destinationFolder: string
  ): Promise<void>;

  disconnect(): Promise<void>;
}
```

This interface is a design target. Adapt its types and optional capabilities to provider limitations.

The application must identify unsupported operations explicitly instead of pretending every provider supports identical functionality.

Use server-side provider adapters. Never put OAuth client secrets, SMTP passwords, or access tokens into the React browser bundle.

