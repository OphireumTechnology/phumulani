xl sm:text-4xl font-bold text-slate-900"},"Our Sacred Mission & Enduring Vision"],["P",{"class":"text-xs sm:text-sm text-slate-600 leading-relaxed"},"Phumulani exists to ensure that every immigrant and refugee survivor of domestic violence, human trafficking, and systemic trauma in Minnesota discovers not merely an escape from danger, but an enduring pathway to sovereignty, self-determination, and thriving peace."]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"},["DIV",{"class":"bg-white p-6 rounded-2xl border border-teal-200/80 shadow-xs space-y-3"},["DIV",{"class":"w-10 h-10 rounded-xl bg-teal-50 text-[#104F57] flex items-center justify-center font-bold"},"01"],["H3",{"class":"font-serif text-lg font-bold text-slate-900"},"Cultural Attunement"],["P",{"class":"text-xs text-slate-600 leading-relaxed"},"Healing cannot be imported from generic clinical models. We center ancestral sisterhood tea circles, indigenous trauma resolution, and bilingual advocates who share lived cultural realities."]],["DIV",{"class":"bg-white p-6 rounded-2xl border border-teal-200/80 shadow-xs space-y-3"},["DIV",{"class":"w-10 h-10 rounded-xl bg-teal-50 text-[#104F57] flex items-center justify-center font-bold"},"02"],["H3",{"class":"font-serif text-lg font-bold text-slate-900"},"Legal Self-Defense"],["P",{"class":"text-xs text-slate-600 leading-relaxed"},"Navigating Orders for Protection (OFP), U-Visa certifications, and immigration relief with relentless, courtroom-accredited accompaniment and trauma-informed legal partners."]],["DIV",{"class":"bg-white p-6 rounded-2xl border border-teal-200/80 shadow-xs space-y-3"},["DIV",{"class":"w-10 h-10 rounded-xl bg-teal-50 text-[#104F57] flex items-center justify-center font-bold"},"03"],["H3",{"class":"font-serif text-lg font-bold text-slate-900"},"Economic Sovereignty"],["P",{"class":"text-xs text-slate-600 leading-relaxed"},"Financial abuse is the most potent anchor of domestic violence. We dismantle dependency through matched savings, rapid lease deposits, credit restoration, and micro-enterprise coaching."]],["DIV",{"class":"bg-white p-6 rounded-2xl border border-teal-200/80 shadow-xs space-y-3"},["DIV",{"class":"w-10 h-10 rounded-xl bg-teal-50 text-[#104F57] flex items-center justify-center font-bold"},"04"],["H3",{"class":"font-serif text-lg font-bold text-slate-900"},"Intergenerational Youth"],["P",{"class":"text-xs text-slate-600 leading-relaxed"},"Breaking generational trauma by investing deeply in the children of survivors through academic tutoring, college preparation, and culturally grounded leadership development."]]]]],["SECTION",{"id":"partnerships-section","class":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16"},["DIV",{"class":"flex flex-col sm:flex-row justify-between items-start sm:items-end mb-10 gap-4"},["DIV",{},["DIV",{"class":"text-xs font-bold text-[#104F57] uppercase tracking-wider"},"Collective Power"],["H2",{"class":"font-serif text-3xl font-bold text-slate-900"},"Community Alliances & Institutional Partners"],["P",{"class":"text-xs text-slate-600 mt-1"},"Phumulani works arm-in-arm with Minnesota public agencies, corporate grantmakers, legal coalitions, and shelter networks."]],["BUTTON",{"class":"px-4 py-2 border border-teal-700 text-[#104F57] hover:bg-teal-50 rounded-lg text-xs font-bold flex items-center gap-1.5 cursor-pointer"},["SPAN",{},"Partner With Phumulani"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-arrow-right w-3.5 h-3.5","aria-hidden":"true"},["path",{"d":"M5 12h14"}],["path",{"d":"m12 5 7 7-7 7"}]]]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6"},["DIV",{"class":"bg-white p-5 rounded-xl border border-slate-200 shadow-2xs space-y-2"},["DIV",{"class":"flex items-center gap-2 text-xs font-bold text-teal-800"},["svg",{"xmlns":"http://www.w3.o