,"height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right w-3.5 h-3.5","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]]],["SPAN",{"class":"text-[11px] text-slate-400"},"By Comfort Dondo"]]]],["DIV",{"class":"bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col group"},["DIV",{"class":"relative bg-slate-900 aspect-[2/3] overflow-hidden flex items-center justify-center p-3"},["IMG",{"__playwright_current_src__":"","alt":"The Gift in Pain","class":"w-full h-full object-contain rounded-md shadow-lg transform group-hover:scale-105 transition-transform duration-300","loading":"lazy","referrerpolicy":"no-referrer","src":"/images/publications/the-gift-in-pain-cover.svg"}],["DIV",{"class":"absolute top-4 right-4 bg-black/70 backdrop-blur-xs text-amber-300 px-2.5 py-1 rounded text-[10px] font-bold border border-amber-400/40"},"Advance Announcement"]],["DIV",{"class":"p-5 flex-1 flex flex-col justify-between space-y-4"},["DIV",{"class":"space-y-1.5"},["SPAN",{"class":"text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono"},"Forthcoming"," Publication"],["H4",{"class":"font-serif text-lg font-bold text-slate-900 group-hover:text-[#104F57] transition-colors"},"The Gift in Pain"],["P",{"class":"text-xs text-[#633C69] font-medium"},"Transforming Trauma into Communal Power"],["P",{"class":"text-xs text-slate-600 line-clamp-3 leading-relaxed pt-1"},"Comfort Dondo’s forthcoming work explores post-traumatic growth, community-led shelter innovations, and the structural methodology behind Phumulani’s six core programs. It examines how collective healing circles and economic independence break the intergenerational cycle of gender-based violence in immigrant diaspora communities."]],["DIV",{"class":"pt-2 border-t border-slate-100 flex items-center justify-between"},["BUTTON",{"clas