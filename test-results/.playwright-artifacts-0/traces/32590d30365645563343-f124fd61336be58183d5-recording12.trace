3-4.24 4.24"}],["circle",{"cx":"12","cy":"12","r":"4"}]],["SPAN",{},"CONFIDENTIAL SAFEGUARDING ROUTE"]],["H2",{"class":"font-serif text-3xl font-bold text-rose-950"},"Safe & Discreet Assistance"],["P",{"class":"text-xs sm:text-sm text-slate-700 leading-relaxed"},"If you are an immigrant or refugee survivor in Minnesota seeking safety, shelter, or legal protection, you can reach out here discreetly."],["DIV",{"class":"bg-white p-4 rounded-xl border border-rose-200 text-xs space-y-2 text-slate-700"},["DIV",{"class":"font-bold text-rose-900 flex items-center gap-1.5"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-shield w-4 h-4 text-rose-700","aria-hidden":"true"},["path",{"d":"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"}]],["SPAN",{},"Our Privacy & Safeguarding Guarantees:"]],["UL",{"class":"space-y-1 list-disc list-inside text-[11px] text-slate-600"},["LI",{},"No third-party tracking scripts or advertising cookies"],["LI",{},"No account creation required"],["LI",{},"Directly routed to trained Safeguarding Officers (never general staff)"],["LI",{},"Zero AI processing on sensitive survivor case records"]]],["DIV",{"class":"p-3 bg-rose-100/70 rounded-xl text-xs text-rose-900 flex items-center justify-between"},["DIV",{},["DIV",{"class":"font-bold"},"Immediate Crisis Line 24/7:"],["DIV",{"class":"text-sm font-semibold"},"1-866-223-1111 (Call or Text)"]],["BUTTON",{"class":"bg-rose-800 hover:bg-rose-900 text-white px-3 py-1.5 rounded-lg text-xs font-semibold flex items-center gap-1"},["SPAN",{},"Quick Exit"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"roun