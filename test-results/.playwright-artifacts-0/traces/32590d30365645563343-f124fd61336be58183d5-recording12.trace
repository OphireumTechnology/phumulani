flects on moving from Zimbabwe, surmounting systemic trauma, and building Phumulani in Minnesota."]],["DIV",{"class":"inline-flex items-center gap-2 text-[11px] text-amber-300 bg-black/60 px-3 py-1 rounded-full border border-amber-400/30"},["SPAN",{},"Duration: ","7:42"],["SPAN",{},"·"],["SPAN",{},"Click to Stream Authentic Video"]]]]],["DIV",{"class":"bg-slate-950 p-4 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 text-xs"},["DIV",{"class":"space-y-0.5 text-slate-400 text-[11px]"},["DIV",{},["STRONG",{"class":"text-slate-300"},"Producer / Copyright:"]," ","Phumulani (Produced in partnership with Twin Cities Community Media)"],["DIV",{"class":"flex items-center gap-1 text-slate-500 font-mono text-[10px]"},["SPAN",{},"SHA-256 Checksum:"],["SPAN",{"class":"truncate max-w-[200px]"},"e5f60718293a4b5c6d7e8f90123456789abcdef0123456789abcdef01234"]]],["DIV",{"class":"flex items-center gap-2"},["BUTTON",{"class":"flex items-center gap-1.5 px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-lg text-xs font-semibold transition-colors cursor-pointer"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-info w-3.5 h-3.5 text-amber-400","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"M12 16v-4"}],["path",{"d":"M12 8h.01"}]],["SPAN",{},"Read Summary"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-down w-3.5 h-3.5","aria-hidden":"true"},["path",{"d":"m6 9 6 6 6-6"}]]],["A",{"href":"https://vimeo.com/874129503","target":"_blank","rel":"noopener noreferrer","class":"flex items-center gap-1 text-[11px] text-teal-400 hover:text-teal-