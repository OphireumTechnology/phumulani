300 underline font-medium px-2 py-1"},["SPAN",{},"Source Video"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-external-link w-3 h-3","aria-hidden":"true"},["path",{"d":"M15 3h6v6"}],["path",{"d":"M10 14 21 3"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"}]]]]]]],["DIV",{"class":"lg:col-span-4 space-y-4"},["DIV",{"class":"bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3"},["DIV",{"class":"font-serif font-bold text-base text-[#104F57] flex items-center gap-2"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-film w-4 h-4 text-[#D67C35]","aria-hidden":"true"},["rect",{"width":"18","height":"18","x":"3","y":"3","rx":"2"}],["path",{"d":"M7 3v18"}],["path",{"d":"M3 7.5h4"}],["path",{"d":"M3 12h18"}],["path",{"d":"M3 16.5h4"}],["path",{"d":"M17 3v18"}],["path",{"d":"M17 7.5h4"}],["path",{"d":"M17 16.5h4"}]],["SPAN",{},"About This Interview"]],["P",{"class":"text-xs text-slate-600 leading-relaxed"},"In this foundational interview, Comfort Dondo details how cultural meals, linguistic safety, and holistic healing allow survivors to release trauma. She explains the essential role of community partnerships in Minnesota and why dignified housing must precede workforce transitions."],["DIV",{"class":"text-[11px] text-slate-500 space-y-1 pt-2 border-t border-slate-200"},["DIV",{},["STRONG",{},"Speaker:"]," Comfort Dondo (Founder)"],["DIV",{},["STRONG",{},"Location:"]," Brooklyn Park, Minnesota"],["DIV",{},["STRONG",{},"Producer:"]," Twin Cities Community Media"]]],["DIV",{"class":"bg-teal-50/60 p-4 rounded-xl border border-teal-200 text-xs text-slate-700 space-y-2"},["DIV",{"class":"font-bold text-[#104F57] flex items-center gap-1.5"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-circle-check w-4 h-4 text-teal-600","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"m9 12 2 2 4-4"}]],["SPAN",{},"Also Featured On CCX Media News"]],["P",{"class":"text-[11px] text-slate-600"},"Phumulani’s Healing Homes program was spotlighted by CCX News as a regional leader in culturally specific domestic abuse recovery."],["A",{"href":"https://www.youtube.com/watch?v=kU7ZqL6Jz7E","target":"_blank","rel":"noopener noreferrer","class":"inline-flex items-center gap-1 font-semibold text-[#104F57] hover:underline"},["SPAN",{},"Watch CCX News Spotlight"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-external-link w-3 h-3","aria-hidden":"true"},["path",{"d":"M15 3h6v6"}],["path",{"d":"M10 14 21 3"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"}]]]]]]],["DIV",{"class":"space-y-6 pt-6"},["DIV",{"class":"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 border-b border-slate-200 pb-3"},["DIV",{},["DIV",{"class":"text-xs font-bold text-[#633C69] tracking-wider uppercase"},"Authored Works & Publications"],["H3",{"class":"font-serif text-2xl font-bold text-slate-900"},"Books by Founder Comfort Dondo"]],["SPAN",{"class":"text-xs text-slate-500"},"Approved literary works advancing survivor resilience"]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-3 gap-8"},["DIV",{"class":"bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col group"},["DIV",{"class":"relative bg-slate-900 aspect-[2/3] overflow-hidden flex items-center justify-center p-3"},["IMG",{"__playwright_current_src__":"","alt":"Facing the Giants","class":"w-full h-full object-contain rounded-md shadow-lg transform group-hover:scale-105 transition-transform duration-300","loading":"lazy","referrerpolicy":"no-referrer","src":"/images/publications/facing-the-giants-cover.svg"}],["DIV",{"class":"absolute top-4 right-4 bg-black/70 backdrop-blur-xs text-amber-300 px-2.5 py-1 rounded text-[10px] font-bold border border-amber-400/40"},"Solo Memoir & Survivor Guide"]],["DIV",{"class":"p-5 flex-1 flex flex-col justify-between space-y-4"},["DIV",{"class":"space-y-1.5"},["SPAN",{"class":"text-[10px] font-bold text-slate-400 uppercase tracking-wider font-mono"},"2021"," Publication"],["H4",{"class":"font-serif text-lg font-bold text-slate-900 group-hover:text-[#104F57] transition-colors"},"Facing the Giants"],["P",{"class":"text-xs text-[#633C69] font-medium"},"A Journey to Freedom from Domestic Abuse"],["P",{"class":"text-xs text-slate-600 line-clamp-3 leading-relaxed pt-1"},"In \"Facing the Giants\", Comfort Dondo recounts her personal journey moving from Zimbabwe to the United States at age 17, surviving childhood trauma and domestic violence, and confronting the towering \"giants\" of systemic isolation, legal intimidation, and cultural silence. The memoir provides a compassionate, practical roadmap for women seeking autonomy, safety, and renewed spiritual faith."]],["DIV",{"class":"pt-2 border-t border-slate-100 flex items-center justify-between"},["BUTTON",{"class":"text-xs font-bold text-[#104F57] hover:text-[#0c3e44] flex items-center gap-1 cursor-pointer"},["SPAN",{},"Read Excerpts & Details"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-chevron-right w-3.5 h-3.5","aria-hidden":"true"},["path",{"d":"m9 18 6-6-6-6"}]]],["SPAN",