d text-[#104F57] flex items-center gap-1.5"},["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-circle-check w-4 h-4 text-teal-600","aria-hidden":"true"},["circle",{"cx":"12","cy":"12","r":"10"}],["path",{"d":"m9 12 2 2 4-4"}]],["SPAN",{},"Also Featured On CCX Media News"]],["P",{"class":"text-[11px] text-slate-600"},"Phumulani’s Healing Homes program was spotlighted by CCX News as a regional leader in culturally specific domestic abuse recovery."],["A",{"href":"https://www.youtube.com/watch?v=kU7ZqL6Jz7E","target":"_blank","rel":"noopener noreferrer","class":"inline-flex items-center gap-1 font-semibold text-[#104F57] hover:underline"},["SPAN",{},"Watch CCX News Spotlight"],["svg",{"xmlns":"http://www.w3.org/2000/svg","width":"24","height":"24","viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","stroke-width":"2","stroke-linecap":"round","stroke-linejoin":"round","class":"lucide lucide-external-link w-3 h-3","aria-hidden":"true"},["path",{"d":"M15 3h6v6"}],["path",{"d":"M10 14 21 3"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"}]]]]]]],["DIV",{"class":"space-y-6 pt-6"},["DIV",{"class":"flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 border-b border-slate-200 pb-3"},["DIV",{},["DIV",{"class":"text-xs font-bold text-[#633C69] tracking-wider uppercase"},"Authored Works & Publications"],["H3",{"class":"font-serif text-2xl font-bold text-slate-900"},"Books by Founder Comfort Dondo"]],["SPAN",{"class":"text-xs text-slate-500"},"Approved literary works advancing survivor resilience"]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-3 gap-8"},["DIV",{"class":"bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-xl transition-all flex flex-col group"},["DIV",{"class":"relative bg-slate-900 aspect-[2/3] overflow-h