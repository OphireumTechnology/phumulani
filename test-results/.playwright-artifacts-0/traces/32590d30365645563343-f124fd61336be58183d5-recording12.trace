{"d":"M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"}],["path",{"d":"M2 12h20"}]],["SPAN",{},"Zero Commercial Ad Tracking"]],["P",{"class":"leading-relaxed text-slate-600"},"Our website contains zero third-party advertising trackers, Facebook Meta pixels, or Google Ads remarketing cookies. Digital interactions remain private and safe from surveillance or behavioral profiling."]]]],["SECTION",{"id":"accessibility-section","class":"bg-slate-900 text-white py-16"},["DIV",{"class":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8"},["DIV",{"class":"border-b border-slate-800 pb-4"},["DIV",{"class":"text-xs font-bold text-teal-300 uppercase tracking-wider"},"Universal Design"],["H2",{"class":"font-serif text-3xl font-bold text-white"},"Accessibility Statement & WCAG 2.2 AA Conformance"],["P",{"class":"text-xs text-slate-400 mt-1"},"Phumulani is committed to ensuring full digital inclusion and dignified usability for people with all physical, sensory, and cognitive abilities."]],["DIV",{"class":"grid grid-cols-1 md:grid-cols-4 gap-6 text-xs"},["DIV",{"class":"bg-slate-800/80 p-4 rounded-xl border border-slate-700 space-y-2"},["DIV",{"class":"font-bold text-teal-300"},"Keyboard Navigation"],["P",{"class":"text-slate-300 leading-relaxed"},"Full Tab, Shift+Tab, and Enter keyboard focus traversal with visible high-contrast focus rings and zero keyboard traps."]],["DIV",{"class":"bg-slate-800/80 p-4 rounded-xl border border-slate-700 space-y-2"},["DIV",{"class":"font-bold text-teal-300"},"Screen Reader Support"],["P",{"class":"text-slate-300 leading-relaxed"},"Semantic HTML5 landmarks (header, nav, main, section, footer) and explicit ARIA labels for non-text SVGs and modal dialogues."]],["DIV",{"class":"bg-slate-800/80 p-4 rounded-xl border border-slate-700 space-y-2"},["DIV",{"class":"font-bold text-teal-300"},"Contrast & Scalability"],["P",{"class":"text-slate-300 leading-relaxed"},"Color contrast ratios meet or exceed 4.5:1 for body copy and 7:1 for headings. Text can be e